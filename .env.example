# Copy this file to `.env` and fill in real values: `cp .env.example .env`
# `.env` is git-ignored. Never commit real secrets.

# --- Gateway authentication --------------------------------------------------
# Clients must send this value in the `X-API-Key` header.
# Generate a strong key with: openssl rand -hex 32
API_KEY=replace-me-with-a-long-random-string

# --- Upstream model server (vLLM, OpenAI-compatible API) ---------------------
# Inside docker compose, `vllm` resolves to the vLLM container on the private
# Docker network (compose always sets this value for the gateway container).
# The vLLM port is never published to the host.
VLLM_BASE_URL=http://vllm:8000

# Model served by vLLM and requested by the gateway (both compose files read it).
#   CPU stack (docker-compose.cpu.yml, current deployment): Qwen/Qwen2.5-1.5B-Instruct
#   GPU stack (docker-compose.yml, T4):                     Qwen/Qwen3-4B-Instruct-2507
MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# --- Timeouts (seconds) for gateway -> vLLM calls -----------------------------
# Generation is much slower on CPU, especially under concurrent load: if the
# CPU stack returns 504 errors, raise VLLM_REQUEST_TIMEOUT_S (e.g. to 180).
VLLM_CONNECT_TIMEOUT_S=5
VLLM_REQUEST_TIMEOUT_S=60

# --- CPU backend only (docker-compose.cpu.yml) ---------------------------------
# KV-cache size in GiB. 4 fits a 16 GB instance next to the ~3 GB of weights.
# Lower it (e.g. to 1) on a laptop with little memory allocated to Docker.
VLLM_CPU_KVCACHE_SPACE=4
# bfloat16 is the recommended dtype on x86 CPUs. If a local test on another
# CPU fails with a dtype error, try float32.
VLLM_CPU_DTYPE=bfloat16

# --- Generation -----------------------------------------------------------------
# Low temperature keeps summaries faithful to the source text.
TEMPERATURE=0.2

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Hugging Face (optional) ---------------------------------------------------
# Not required for the Qwen models above (public, non-gated, Apache-2.0).
# Setting it avoids anonymous download rate limits.
HF_TOKEN=
