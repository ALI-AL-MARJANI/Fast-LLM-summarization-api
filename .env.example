# Copy this file to `.env` and fill in real values: `cp .env.example .env`
# `.env` is git-ignored. Never commit real secrets.

# --- Gateway authentication --------------------------------------------------
# Clients must send this value in the `X-API-Key` header.
# Generate a strong key with: openssl rand -hex 32
API_KEY=replace-me-with-a-long-random-string

# --- Upstream model server (vLLM, OpenAI-compatible API) ---------------------
# Inside docker compose, `vllm` resolves to the vLLM container on the private
# Docker network (compose always sets this value for the gateway container).
# The vLLM port is never published to the host.
VLLM_BASE_URL=http://vllm:8000
MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507

# --- Timeouts (seconds) for gateway -> vLLM calls -----------------------------
VLLM_CONNECT_TIMEOUT_S=5
VLLM_REQUEST_TIMEOUT_S=60

# --- Generation -----------------------------------------------------------------
# Low temperature keeps summaries faithful to the source text.
TEMPERATURE=0.2

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Hugging Face (optional) ---------------------------------------------------
# Not required for Qwen3-4B-Instruct-2507 (public, non-gated model).
# Setting it avoids anonymous download rate limits.
HF_TOKEN=
